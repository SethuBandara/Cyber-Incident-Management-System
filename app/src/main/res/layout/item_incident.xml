<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="#151D2B">

    <!-- Incident title -->
    <TextView
        android:id="@+id/tvIncidentTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phishing Attack Detected"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Incident type -->
    <TextView
        android:id="@+id/tvIncidentType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Type: Phishing"
        android:textColor="#AAB7C4"
        android:textSize="14sp" />

    <!-- Severity and status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tvSeverity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRITICAL"
            android:textColor="#FF5252"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="OPEN"
            android:textColor="#FFB74D"
            android:textStyle="bold"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Reported date -->
    <TextView
        android:id="@+id/tvIncidentDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Reported: 2026-11-08"
        android:textColor="#AAB7C4"
        android:textSize="13sp" />

    <!-- Affected asset -->
    <TextView
        android:id="@+id/tvAffectedAsset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Asset: Employee Email"
        android:textColor="#AAB7C4"
        android:textSize="13sp" />

    <!-- Edit and Delete buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Edit"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="Delete"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>