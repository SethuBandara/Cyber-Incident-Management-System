<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".WelcomeActivity">

    <!-- Icon -->
    <ImageView
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="App Logo"
        android:src="@drawable/ic_security_shield" />

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Cyber Incident Management System"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:text="Manage and track security incidents efficiently"
        android:textColor="#AAB7C4"
        android:textSize="14sp" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnEnterDashboard"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="View Incidents Dashboard"
        android:textAllCaps="false"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnReportIncident"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#151D2B"
        android:text="+ Add New Incident"
        android:textAllCaps="false"
        android:textColor="#3B82F6"
        android:textSize="15sp" />

</LinearLayout>
