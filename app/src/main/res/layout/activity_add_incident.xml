<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddIncidentActivity"
    android:background="#0B1120"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Form heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REPORT SECURITY INCIDENT"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter the incident details below."
            android:textColor="#AAB7C4"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <!-- Incident title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Incident Title *"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Phishing Attack Detected"
            android:inputType="textCapSentences"
            android:textColor="#FFFFFF"
            android:textColorHint="#8995A5"
            android:backgroundTint="#3B82F6"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:hint="Describe what happened..."
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:textColor="#FFFFFF"
            android:textColorHint="#8995A5"
            android:backgroundTint="#3B82F6"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Incident category -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Incident Category"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Severity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Severity"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerSeverity"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Status -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Incident Status"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerStatus"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Reported date -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reported Date"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReportedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2026-11-09"
            android:textColor="#64B5F6"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="#151D2B"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Affected asset -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Affected Asset"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAffectedAsset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Employee Email"
            android:inputType="textCapSentences"
            android:textColor="#FFFFFF"
            android:textColorHint="#8995A5"
            android:backgroundTint="#3B82F6"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- Save button -->
        <Button
            android:id="@+id/btnSaveIncident"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE INCIDENT"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <!-- Cancel button -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CANCEL"
            android:textAllCaps="false"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>